# .env.example — copy to .env and fill in for live testnet use
# NEVER commit .env to git

# EVM private key for Base Sepolia (funded with test ETH)
EVM_PRIVATE_KEY=

# Base Sepolia RPC (default: public endpoint, may be rate-limited)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Basescan API key (optional, for contract verification)
BASESCAN_API_KEY=

# BCH Chipnet WIF private key (funded from faucet)
BCH_CHIPNET_WIF=

# Demo mode: "local" (Hardhat) or "testnet"
DEMO_MODE=local
